{
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "${env:HOME}/.platformio/packages/framework-arduinoespressif32/**",
        "${env:HOME}/.platformio/packages/framework-arduinoespressif32/cores/esp32/**",
        "${env:HOME}/.platformio/packages/framework-arduinoespressif32/libraries/**",
        "${env:HOME}/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include/**",
        "${workspaceFolder}/.pio/libdeps/esp32dev/**"
    ],
    "C_Cpp.default.defines": [
        "ARDUINO_ESP32_DEV",
        "ESP32",
        "ARDUINO=10816",
        "F_CPU=240000000L"
    ],
    "C_Cpp.default.compilerPath": "${env:HOME}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-gcc",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.intelliSenseEngine": "Tag Parser",
    "files.associations": {
        "*.ino": "cpp"
    }
}
